@{
    ViewData["Title"] = "Home";
}

<div class="card">
    <h1>Welcome to Role-Based Auth Demo</h1>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <p>Hello <strong>@User.Identity.Name</strong></p>
        <p>Your roles:
            @string.Join(", ", ((System.Security.Claims.ClaimsIdentity)User.Identity)
                .Claims
                .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
                .Select(c => c.Value))
        </p>

        @if (User.IsInRole("Admin"))
        {
            <a href="/Admin" class="btn btn-danger">Go to Admin Panel</a>
        }
    }
    else
    {
        <p>Please <a href="/Account/Login">login</a> or <a href="/Account/Register">register</a>.</p>
    }
</div>
